Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 520
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 34; 40
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: RSSI heat map (strongest AP)
      Enabled: true
      Alpha: 0.55
      Color Scheme: costmap
      Topic:
        Value: /wiloc/rssi_heatmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Floor plan and APs
      Enabled: true
      Topic:
        Value: /wiloc/environment
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (TF via map->odom->base)
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PoseArray
      Name: Particles
      Enabled: true
      Topic:
        Value: /wiloc/particles
      Color: 255; 200; 40
      Shape: Arrow (Flat)
      Arrow Length: 0.15
      Head Length: 0.04
      Head Radius: 0.03
      Shaft Length: 0.11
      Shaft Radius: 0.01
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: WiLoc estimate
      Enabled: true
      Topic:
        Value: /wiloc/pose
      Shape: Arrow
      Color: 30; 144; 255
      Shaft Length: 0.4
      Shaft Radius: 0.05
      Head Length: 0.15
      Head Radius: 0.1
      Covariance:
        Position:
          Alpha: 0.35
          Color: 30; 144; 255
          Scale: 2
        Orientation:
          Value: false
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Raw Wi-Fi fix (WKNN)
      Enabled: true
      Topic:
        Value: /wiloc/wifi_fix
      Shape: Axes
      Axes Length: 0.2
      Axes Radius: 0.03
      Covariance:
        Position:
          Alpha: 0.15
          Color: 255; 120; 0
          Scale: 1
        Orientation:
          Value: false
    - Class: rviz_default_plugins/Path
      Name: Estimated path
      Enabled: true
      Topic:
        Value: /wiloc/path
      Color: 30; 144; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Ground-truth path
      Enabled: true
      Topic:
        Value: /wiloc/ground_truth_path
      Color: 255; 255; 255
      Line Style: Lines
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top
      X: 10
      Y: 6
      Scale: 45
      Angle: 0
Window Geometry:
  Width: 1500
  Height: 900
